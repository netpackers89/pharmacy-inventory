# Supabase: Project Settings -> Database -> Connection string (URI)
# Use the direct connection string for Render, not the pooler string.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Required in production. Generate a long random value.
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
NODE_ENV=development

# Comma-separated allowed browser origins. Add your frontend production URL (onrender) in production.
FRONTEND_URL=http://localhost:3000

# Rate limiting (optional — sensible defaults are applied)
# Requests per minute per IP for the whole API
RATE_LIMIT_API_PER_MIN=300
# Login attempts per 15 minutes per IP (brute-force lockout is ALSO stored
# in the database per username+IP: 3 failures → 5 min, then 10/15/30/60 min)
RATE_LIMIT_LOGIN_PER_15MIN=30

# Initial administrator account (optional — used by `npm run seed`).
# Defaults: ADMIN_USERNAME=admin, ADMIN_PASSWORD=admin123,
#           ADMIN_FULL_NAME="System Administrator", ADMIN_USER_ID=auto (bigserial).
# ADMIN_USER_ID forces a specific users.user_id — it must be a FREE id.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# ADMIN_FULL_NAME=System Administrator
# ADMIN_USER_ID=1


# ─── AI CLINICAL AUTOFILL (Google Gemini) ────────────────────────────────────
# Create a PERMANENT API KEY at https://aistudio.google.com/apikey
# It must start with "AIza" (about 39 characters).
# NOTE: OAuth access tokens ("AQ.…" / "ya29.…") expire after about an hour and
#       are not a replacement for an API key.
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_FROM_AI_STUDIO
# Optional tuning (safe defaults apply when omitted)
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-3.8-flash
# GEMINI_TIMEOUT_MS=20000          # per-attempt timeout
# GEMINI_TOTAL_TIMEOUT_MS=25000    # hard budget for the whole operation
# GEMINI_MAX_OUTPUT_TOKENS=4096
# GEMINI_DEBUG=1                   # log the raw model answer when JSON parsing fails

# ─── TELEGRAM INVENTORY ALERTS (backend only — never expose to React) ────────
# 1. Create / regenerate the bot token in Telegram @BotFather.
#    The numeric bot id (for example 8720078982) is NOT the chat id.
# TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
# 2. Send "/start" to the bot in Telegram, then call
#    GET /api/notifications/telegram/chats (admin JWT) to read the real chat id.
#    For a group, add the bot to the group and use the group's negative id.
# TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
# Optional alert tuning
# EXPIRY_ALERT_DAYS=90,60,30,7
# CRITICAL_STOCK_THRESHOLD=5
# ALERT_CHECK_INTERVAL_MINUTES=30
# ALERT_MAX_MESSAGES_PER_RUN=20
# ALERT_REPEAT_HOURS=0            # 0 = notify once per state change (recommended)
# TELEGRAM_TIMEOUT_MS=10000
# TELEGRAM_DOCUMENT_TIMEOUT_MS=45000   # upload timeout for .xlsx report attachments
# TELEGRAM_DOCUMENT_MAX_BYTES=47185920 # 45 MB hard cap (Telegram's bot limit is 50 MB)

# ─── SCHEDULED TELEGRAM REPORTS (backend only) ────────────────────────────────
# Reports are generated from PostgreSQL. The 12-hour inventory update defaults
# to a concise Telegram text summary; choose TEXT, CSV, or EXCEL for its format.
# Manual sends in Reports can independently choose text, CSV, or Excel.
# TZ=Africa/Addis_Ababa
# REPORT_TIMEZONE=Africa/Addis_Ababa     # overrides TZ for report windows only
# REPORT_INTERVAL_HOURS=12                # supported: 1, 2, 3, 4, 6, 8, 12, 24
# REPORT_INTERVAL_FORMAT=TEXT             # TEXT, CSV, or EXCEL
# REPORT_INTERVAL_ENABLED=true
#
# Cron expressions (5-field) evaluated in the reporting timezone:
#   weekly  = every Monday 07:00   -> "0 7 * * 1"
#   monthly = 1st of the month 07:00 -> "0 7 1 * *"
# REPORT_WEEKLY_CRON=0 7 * * 1
# REPORT_MONTHLY_CRON=0 7 1 * *
#
# Fallback schedule (used only when node-cron is unavailable): REPORT_HOUR=7
#
# A deployment that restarts near the scheduled time re-delivers the missed
# period once, within this window. Deduplication prevents a second send.
# REPORT_CATCHUP_HOURS=72
#
# Master switch — set to false to disable ALL scheduled reports.
# REPORTS_ENABLED=true
#
# Safety caps so a very large table cannot exhaust memory in a workbook.
# REPORT_MAX_MOVEMENT_ROWS=5000
# REPORT_MAX_AUDIT_ROWS=5000
# REPORT_MAX_BIN_CARD_ROWS=3000
#
# Per-type toggles (ADMIN-editable in the app; these keys live in the settings
# table and override the defaults, e.g. via PUT /api/settings/<key>):
#   telegram_enabled            false disables every Telegram notification
#   weekly_report_enabled       false disables the weekly scheduled report
#   monthly_report_enabled      false disables the monthly scheduled report
#   inventory_report_enabled    false disables the inventory workbook
#   audit_report_enabled        false disables the audit workbook
#   alerts_enabled              false disables all inventory alerts
#   alert_low_stock_enabled     false disables LOW STOCK alerts
#   alert_out_of_stock_enabled  false disables CRITICAL / OUT OF STOCK alerts
#   alert_expiry_enabled        false disables near-expiry / expired alerts
